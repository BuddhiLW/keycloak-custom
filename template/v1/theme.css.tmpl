{{if .Font.ImportURL}}@import url("{{.Font.ImportURL}}");
{{end}}/* GENERATED by kctheme render from theme.yaml — DO NOT EDIT.
 * tenant: {{.Tenant}}   scheme: {{.Scheme}}   template: v1
 *
 * Scope: design tokens, page chrome, the login card, the primary button and
 * text inputs. It deliberately does not restyle error banners, alerts, or the
 * OTP/recovery templates: those shift between Keycloak minors, and a theme
 * reaching into them breaks silently on upgrade, discovered only when someone
 * cannot log in.
 *
 * That restraint is structural, not advisory — a tenant supplies tokens, never
 * CSS, and the shared Keycloak CR projects this file as the ONLY tenant source.
 * login/theme.properties is platform-owned, so parent=, styles=, meta= and
 * import= are unreachable from a theme repo.
 */

:root {
  --kc-brand-bg: {{.Tokens.Bg}};
  --kc-brand-surface: {{.Tokens.Surface}};
  --kc-brand-surface-alt: {{.Tokens.SurfaceAlt}};
  --kc-brand-border: {{.Tokens.Border}};
  --kc-brand-text: {{.Tokens.Text}};
  --kc-brand-muted: {{.Tokens.Muted}};
  --kc-brand-dim: {{.Tokens.Dim}};
  --kc-brand-accent: {{.Tokens.Accent}};
  --kc-brand-accent-hover: {{.Tokens.AccentHover}};
  --kc-brand-input-bg: {{.Tokens.InputBg}};
  /* Derived, not tokens: the button label is the product's stated accent ink,
   * or white-vs-page-ink by contrast. Hard-coding #fff is how the retired theme
   * shipped a 3.16:1 primary button. */
  --kc-brand-on-accent: {{.OnAccent}};
  --kc-brand-focus-ring: {{.FocusRing}};

  /* keycloak.v2's OWN theming surface — the supported way to restyle it, and
   * cheaper than out-specificity-ing its rules.
   *   card-top-color: otherwise a 4px PatternFly blue bar sits on the card.
   *   bg-logo-url:    otherwise the stock Keycloak background image covers the
   *                   brand ground entirely. */
  --keycloak-card-top-color: var(--kc-brand-accent);
  --keycloak-bg-logo-url: none;
{{- if .LogoCSSValue}}
  --keycloak-logo-url: {{.LogoCSSValue}};
  --keycloak-logo-width: {{.LogoWidth}}px;
  --keycloak-logo-height: {{.LogoHeight}}px;
{{- end}}
}
{{if .LogoCSSValue}}
/* The brand lockup has to be PAINTED here, not merely declared as a custom
 * property. Measured on 26.6.1: nothing in the served stylesheet consumes
 * --keycloak-logo-url, so setting it alone renders no logo at all.
 *
 * The header element differs by version. 26.6.1 emits
 *   <div id="kc-header-wrapper" class="pf-v5-c-brand"><b>{realm displayName}</b></div>
 * while earlier builds emitted <div class="kc-logo-text"><span>Keycloak</span></div>.
 * Both are matched so a theme does not silently lose its logo on either.
 *
 * The text inside is retired visually rather than removed: PatternFly colours it
 * white for a dark masthead, which is invisible on a light ground, and a product
 * whose artwork already carries its name does not want it twice. font-size:0
 * (not display:none) keeps it in the accessibility tree.
 *
 * background-size: contain — a generated SVG is authored at exactly
 * --keycloak-logo-width/height so contain is a no-op for it, while real artwork
 * has its own aspect and would otherwise be cropped and tiled. Both layers of a
 * two-layer logo share this box, so the placeholder and the full-resolution file
 * land in the same place and the swap is invisible. */
#kc-header-wrapper,
div.kc-logo-text {
  display: block;
  width: var(--keycloak-logo-width);
  height: var(--keycloak-logo-height);
  margin: 0 auto;
  padding: 0;
  background-image: var(--keycloak-logo-url);
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  font-size: 0;
  line-height: 0;
  color: transparent;
}
{{else}}
/* No brand lockup, but PatternFly still paints the realm name white for a dark
 * masthead. On this light ground that is white-on-white — the name is present,
 * selectable and invisible. */
#kc-header-wrapper {
  color: var(--kc-brand-text);
}
{{end}}

/* ---------- page ---------- */

body,
.pf-v5-c-background-image,
.login-pf body {
  background: {{.Gradient}};
  color: var(--kc-brand-text);
  font-family: {{.Font.Body}};
}

/* keycloak.v2 paints its own background on the wrapper; without this the card
 * floats on the stock colour and only the page margin picks up the brand. */
.pf-v5-c-login,
.pf-v5-c-page,
.login-pf-page {
  background: transparent;
}

/* ---------- login card ---------- */

.pf-v5-c-login__main,
.card-pf {
  background: var(--kc-brand-surface);
  border: 1px solid var(--kc-brand-border);
  border-radius: {{.Card.Radius}};
  box-shadow: {{.Card.Shadow}};
  /* keycloak.v2 puts the accent bar on the HEADER, not the card, so without
   * clipping it keeps square corners while the card is rounded. */
  overflow: hidden;
}

.pf-v5-c-login__main-header,
.pf-v5-c-login__main-body {
  padding: {{.Card.Padding}};
}

.pf-v5-c-login__container {
  max-width: {{.Card.Width}};
}

.pf-v5-c-login__main-header-desc,
.pf-v5-c-login__main-footer-band {
  color: var(--kc-brand-muted);
}

/* The footer band sits on its own surface in keycloak.v2; left alone it reads
 * as a lighter rectangle glued to the bottom of a dark card. */
.pf-v5-c-login__main-footer-band {
  background: var(--kc-brand-surface-alt);
  border-top: 1px solid var(--kc-brand-border);
}

/* displayNameHtml is injected here; the realm sets the wordmark colours inline
 * so the header still reads correctly against the stock theme too. */
#kc-header-wrapper,
.pf-v5-c-login__header,
.pf-v5-c-login__main-header-title,
#kc-page-title {
  color: var(--kc-brand-text);
  font-family: {{.Font.Heading}};
}

/* ---------- primary action ---------- */

.pf-v5-c-button.pf-m-primary,
input[type="submit"].pf-v5-c-button.pf-m-primary,
#kc-login {
  background: var(--kc-brand-accent);
  border-color: var(--kc-brand-accent);
  color: var(--kc-brand-on-accent);
  border-radius: {{.Control.Radius}};
  padding: {{.Control.ButtonPad}};
  font-weight: {{.Control.FontWeight}};
}

.pf-v5-c-button.pf-m-primary:hover,
#kc-login:hover {
  background: var(--kc-brand-accent-hover);
  border-color: var(--kc-brand-accent-hover);
}

/* Secondary actions must not read as primary — keycloak.v2 gives them the same
 * weight, which on a branded card makes two competing calls to action. */
.pf-v5-c-button.pf-m-secondary,
.pf-v5-c-button.pf-m-link {
  background: var(--kc-brand-surface-alt);
  border: 1px solid var(--kc-brand-border);
  color: var(--kc-brand-text);
  border-radius: {{.Control.Radius}};
}

/* ---------- links ---------- */

a,
.pf-v5-c-login__main-footer-band-item a,
#kc-registration a,
#kc-registration-container a {
  color: var(--kc-brand-accent);
}

a:hover {
  color: var(--kc-brand-accent-hover);
}

/* ---------- inputs ----------
 * In PatternFly v5 `.pf-v5-c-form-control` is a <span> WRAPPER around the real
 * <input>. Styling both draws two nested borders — the box-in-a-box the first
 * render of this theme shipped. The wrapper owns the frame; the input inside is
 * stripped to nothing. */

.pf-v5-c-form-control {
  background: var(--kc-brand-input-bg);
  border: 1px solid var(--kc-brand-border);
  border-radius: {{.Control.InputRadius}};
  padding: {{.Control.InputPad}};
  color: var(--kc-brand-text);
}

/* keycloak.v2 draws the field underline with a ::after inset box-shadow, which
 * survives every border override and reads as a stray line. */
.pf-v5-c-form-control::after {
  border: none;
  box-shadow: none;
}

.pf-v5-c-form-control > input,
.pf-v5-c-form-control > select,
.pf-v5-c-form-control > textarea {
  background: transparent;
  border: none;
  outline: none;
  color: inherit;
  padding: 0;
  width: 100%;
}

.pf-v5-c-form-control:focus-within {
  border-color: var(--kc-brand-accent);
  box-shadow: 0 0 0 3px var(--kc-brand-focus-ring);
  outline: none;
}

/* The password-reveal eye is a pf-m-control button; left stock it renders as a
 * white tile welded to the side of a dark field. */
.pf-v5-c-button.pf-m-control {
  background: var(--kc-brand-surface-alt);
  border: 1px solid var(--kc-brand-border);
  border-inline-start: none;
  color: var(--kc-brand-muted);
  border-start-end-radius: {{.Control.InputRadius}};
  border-end-end-radius: {{.Control.InputRadius}};
}

.pf-v5-c-button.pf-m-control::after {
  border: none;
}

.pf-v5-c-button.pf-m-control:hover {
  color: var(--kc-brand-text);
}

/* The input-group must not re-introduce a frame around wrapper + button. */
.pf-v5-c-input-group,
.pf-v5-c-input-group__item {
  background: transparent;
  border: none;
}

.pf-v5-c-form__label-text {
  color: var(--kc-brand-muted);
}

.pf-v5-c-form__helper-text {
  color: var(--kc-brand-dim);
}
{{if .Light}}
/* Honour a viewer's light-mode preference. The accent does NOT stay constant
 * across the two: one colour cannot clear 4.5:1 against both a near-white and a
 * near-black surface, so light mode carries its own. Emitted only for
 * scheme: dark-first. */
@media (prefers-color-scheme: light) {
  :root {
    --kc-brand-bg: {{.Light.Bg}};
    --kc-brand-surface: {{.Light.Surface}};
    --kc-brand-surface-alt: {{.Light.SurfaceAlt}};
    --kc-brand-border: {{.Light.Border}};
    --kc-brand-text: {{.Light.Text}};
    --kc-brand-muted: {{.Light.Muted}};
    --kc-brand-dim: {{.Light.Dim}};
    --kc-brand-input-bg: {{.Light.InputBg}};
    --kc-brand-accent: {{.Light.Accent}};
    --kc-brand-accent-hover: {{.Light.AccentHover}};
    --kc-brand-on-accent: {{.LightOnAccent}};
    --kc-brand-focus-ring: {{.LightFocusRing}};
{{- if .LightLogoDataURI}}
    /* The lockup is a background image, so it cannot inherit currentColor. A
     * dark-first tenant that did not repaint it here would serve its dark
     * wordmark onto a near-white card. Geometry is unchanged, so the width and
     * height set in :root still hold. */
    --keycloak-logo-url: url("{{.LightLogoDataURI}}");
{{- end}}
  }

  body,
  .login-pf body {
    background: {{.LightGradient}};
  }
}
{{end}}